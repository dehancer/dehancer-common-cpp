prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: dehancer-common-cpp
Description: Dehancer common layer SDK
Version: @PROJECT_VERSION@
URL: https://github.com/dehancer/dehancer-common-cpp
Requires: base64cpp
Requires.private: ed25519cpp sqlite3
Libs: -L${libdir} -ldehancer_common_cpp -led25519cpp
Libs.private: @libs_private@
CFlags: -I${includedir}
