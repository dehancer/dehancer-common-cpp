@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(NOT TARGET base64cpp::base64cpp)
    find_dependency(base64cpp CONFIG)
endif()
if(NOT TARGET ed25519cpp::ed25519cpp)
    find_dependency(ed25519cpp CONFIG)
endif()
if(NOT TARGET SQLite3::SQLite3)
    find_dependency(SQLite3)
endif()
if(NOT TARGET Threads::Threads)
    find_dependency(Threads)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/dehancer_common_cppTargets.cmake")
check_required_components(dehancer_common_cpp)
